# ─────────────────────────────────────────────────────────────
# TALENTHAUS — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local and populate with verified secrets.
# NEVER commit .env.local, API keys, or production secrets to Git.
# ─────────────────────────────────────────────────────────────

# Supabase Public Configuration (Required for Client Auth & Queries)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Supabase Server Role Key (Optional / Server-side privileged operations only)
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Cloudinary Storage Configuration (Required for Executive & Creator Media Uploads)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Public Site URL
NEXT_PUBLIC_SITE_URL=https://talenthaus.in
